---
/**
 * /contact — contact form.
 *
 * The form POSTs to /api/contact, which the avalia-web nginx proxies to
 * the sidecar mailer container (deploy/mailer/). The mailer validates +
 * SMTPs via Gmail.
 *
 * In `npm run dev` the /api/contact route doesn't exist (no proxy locally),
 * so the fetch will fail and the form falls back to a friendly toast.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/Section.astro';
import Field from '../components/Field.astro';
import Button from '../components/Button.astro';
---
<BaseLayout title="Contact — Avalia" active="contact">

  <Section eyebrow="Contact" title="Get in touch">
    <div style="max-width:560px">
      <p style="color:var(--text-secondary);margin-top:-12px">
        Questions or support — drop a line and I'll get back within 24 hours.
        You don't have to fill out an email address. We'll always try to contact you in-world!
      </p>

      <form id="contact-form" style="display:flex;flex-direction:column;gap:18px;margin-top:32px" novalidate>
        <Field label="Name" name="name" placeholder="Your SL name or real name" required />
        <Field label="Email (optional)" name="email" type="email" placeholder="you@example.com" />
        <Field label="Brand" name="brand" as="select"
               options={["Ava's Lewd", 'HDM']} />
        <Field label="Message" name="message" as="textarea" placeholder="How can I help?" required />

        {/* Honeypot — real users never see this; bots fill it and get filtered. */}
        <input type="text" name="website" tabindex="-1" autocomplete="off"
               aria-hidden="true"
               style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0" />

        <div style="margin-top:8px">
          <Button type="submit" variant="primary" size="lg">Send message</Button>
        </div>
      </form>
    </div>
  </Section>

  <script is:inline>
    // Prefill the brand from ?brand= (e.g. the HDM page links here as
    // /contact?brand=HDM). Updates the native <select> + the skinned dropdown
    // directly so it's independent of the custom-select init timing.
    (function () {
      try {
        var want = new URLSearchParams(location.search).get('brand');
        if (!want) return;
        var sel = document.getElementById('brand');
        if (!sel) return;
        var match = Array.prototype.slice.call(sel.options).filter(function (o) {
          return o.value.toLowerCase() === want.toLowerCase();
        })[0];
        if (!match) return;
        sel.value = match.value;
        var root = sel.closest('[data-cselect]');
        if (root) {
          var label = root.querySelector('[data-cselect-label]');
          if (label) label.textContent = match.textContent || match.value;
          root.querySelectorAll('[data-cselect-option]').forEach(function (o) {
            var on = o.getAttribute('data-value') === match.value;
            o.classList.toggle('is-active', on);
            o.setAttribute('aria-selected', on ? 'true' : 'false');
          });
        }
      } catch (e) {}
    })();

    (function () {
      var form = document.getElementById('contact-form');
      var submitBtn = form && form.querySelector('button[type=submit]');
      if (!form) return;

      function toast(type, title, message) {
        if (window.AvaliaUI) AvaliaUI.toast({ type: type, title: title, message: message });
      }

      form.addEventListener('submit', async function (e) {
        e.preventDefault();
        var data = Object.fromEntries(new FormData(form).entries());

        // Email is optional — we reply in-world when it's left blank.
        if (!data.name || !data.message) {
          toast('info', 'Missing fields', 'Please fill in your name and a message.');
          return;
        }

        if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending…'; }

        try {
          var res = await fetch('/api/contact', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(data)
          });
          var body = await res.json().catch(function () { return {}; });
          if (res.ok && body.ok) {
            toast('success', 'Message sent', 'Thanks — I\'ll reply within 24 hours.');
            form.reset();
          } else if (res.status === 429) {
            toast('info', 'Too many submits', 'Please wait a bit before trying again.');
          } else {
            toast('info', 'Could not send', body.error || 'Please try again, or catch me in-world.');
          }
        } catch (err) {
          // No backend reachable (dev mode, or mailer down) — degrade gracefully.
          console.log('[contact] fetch failed:', err);
          toast('info', 'Send unavailable', 'Try again later, or catch me in-world.');
        } finally {
          if (submitBtn) { submitBtn.disabled = false; submitBtn.textContent = 'Send message'; }
        }
      });
    })();
  </script>

</BaseLayout>

# Avalia site/mailer secrets — copy to .env next to docker-compose.yml on the
# mini-pc, then `docker compose up -d`. Never commit the real .env.

# Gmail SMTP (use an App Password, NOT your account password).
# See https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=avalia.ferrentino@gmail.com
SMTP_PASS=

# Destination + visible From header.
MAIL_TO=avalia.ferrentino@gmail.com
MAIL_FROM=Avalia Contact <avalia.ferrentino@gmail.com>

# Optional: max contact-form submits per IP per hour (default 5).
RATE_PER_HOUR=5

# ─── avalia-builder (auto-rebuild on Directus webhook) ──────────────────────
# Shared secret. Directus sends this in the `X-Avalia-Token` header; the
# builder rejects requests that don't match. Generate one with:
#   openssl rand -hex 32
HOOK_TOKEN=

# Git repo to build from. Override to a private fork via SSH if needed.
REPO_URL=https://github.com/erikhuijs2023/avalia.rocks.git
GIT_BRANCH=main

# Directus URL the build hits during `npm run build`. Default is the local
# Directus on this same mini-pc; change only if you move the CMS.
DIRECTUS_URL=http://192.168.178.29:8085

# Debounce window (ms) — collapses bursts of saves into one build. 0 disables.
DEBOUNCE_MS=10000

# ─── avalia-notifier (SL group notices via SmartBots) ───────────────────────
# Shared secret for POST /notice, sent by Directus in `X-Avalia-Token`.
# Generate with `openssl rand -hex 32`. Use a DIFFERENT value than HOOK_TOKEN.
NOTICE_TOKEN=

# SmartBots credentials — https://www.mysmartbots.com/ , bot panel:
#   SB_APIKEY     developer API key (account level)
#   SB_BOTNAME    the bot's SL login name, e.g. "Avalia Bot"
#   SB_SECRET     the bot's access code
#   SB_GROUP_UUID UUID of the SL group to notify. The bot must be IN that group
#                 in a role that has the "Send Notices" ability — SmartBots
#                 returns OK even when it doesn't, so check this in-world.
SB_APIKEY=
SB_BOTNAME=
SB_SECRET=
SB_GROUP_UUID=

# Optional: inventory UUID (NOT asset UUID) of an item in the bot's inventory
# attached to every notice that doesn't specify its own — a store landmark is
# the usual choice. Find it on the SmartBots account inventory page.
SB_ATTACHMENT=

# Optional: inventory folder UUID for textures/notecards the notifier uploads,
# so they don't pile up loose in the bot's inventory. Same idea as
# SL_TEXTURE_FOLDER_UUID in the SL production daemon.
SB_FOLDER_UUID=

# Optional: longest edge (px) of an uploaded notice texture. SL caps at 1024
# and downscales anything larger itself.
IMAGE_MAX=1024

# Optional: cap on the notice subject (default 63). SmartBots allows 254, but
# long headers wrap badly in the SL notification toast.
SUBJECT_MAX=63

# Static token of the "notice-bot" Directus user (read updates, stamp
# notice_sent_at). Generate with `openssl rand -hex 32`, then run
# deploy/cms/build-schema.mjs with NOTIFIER_TOKEN set to the same value.
NOTIFIER_TOKEN=

# Public site URL used for the fallback link in a notice (default avalia.rocks).
SITE_URL=https://avalia.rocks

# ─── support tickets ─────────────────────────────────────────────────────────
# Static token of the "mailer-bot" Directus user (create-only on tickets).
# Generate with `openssl rand -hex 32`, then run deploy/cms/build-schema.mjs
# with TICKETS_TOKEN set so the bot user gets the same token. When set, every
# contact-form submission is stored as a ticket in Directus next to the mail.
TICKETS_TOKEN=
